<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="asia.sweethome.location.mapper.LocationMapper">

    <select id="selectLastestByFamilyId" resultType="asia.sweethome.location.entity.po.Location"
            parameterType="java.lang.Long">
        SELECT * FROM

        (
            SELECT
                *,
                ROW_NUMBER() OVER
                    (PARTITION BY user_id ORDER BY updated_at desc ) as rn
            from location
            where family_id = #{familyId}
        )

        t where t.rn = 1
    </select>
</mapper>
